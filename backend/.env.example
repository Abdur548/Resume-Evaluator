# COPY this file to backend/.env -- do not rename it, or the template
# disappears from the repo. backend/.env is gitignored; this file is not, so
# never put a real key here.
#
# backend/.env is loaded automatically when the backend starts. A variable that
# is already set in the environment always wins over the value here.

# Optional. Without it the deterministic resume and job-fit evaluations still
# run; the Gemini supplements return null with a skip status and nothing is
# sent anywhere. With it, resume and job-description text is sent to Google's
# Gemini API under your own key -- see "Data sent to Gemini" in readme.md.
GEMINI_API_KEY=

# Optional. Overrides the Gemini model. Leave blank to use the pinned default
# in backend/llm.py. Set this if Google retires that model for new API keys --
# the symptom is a 404 NOT_FOUND naming a replacement model.
GEMINI_MODEL=

# Optional. Comma-separated HTTP(S) origin allowlist for the frontend.
# Leave blank to use the defaults: http://localhost:3000,http://localhost:5173
CORS_ORIGINS=
