# Python
backend/__pycache__/
__pycache__/
.pytest_cache/
*.py[cod]

# Test and coverage artifacts
.coverage
coverage.xml
htmlcov/

# Secrets. GEMINI_API_KEY is a backend value, so the natural place to put it
# is a backend or root .env -- neither of which was covered before.
.env
.env.*
!.env.example

# Personal resumes used for local testing. Real resumes carry names, emails,
# phone numbers and addresses and must never be committed. Checked-in test
# fixtures live in backend/ (sample_resume.*), not here.
data/
backend/data/

# Virtual environments. The canonical one is backend/.venv (see readme.md);
# the unanchored patterns also catch a venv created from the wrong directory.
.venv/
venv/

# Frontend dependencies and output. Unanchored as well as frontend-specific,
# so a package added anywhere else is covered too.
frontend/node_modules/
frontend/dist/
node_modules/
dist/

# Editor and OS noise
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
